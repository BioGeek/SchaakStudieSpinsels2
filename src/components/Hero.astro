---
import CoverMark from './CoverMark.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<section class="hero overflow-hidden rounded-2xl bg-gold text-paper-light shadow-md">
  <div class="hero-grid p-8 sm:p-12">
    <p class="ht-tagline text-xs font-semibold uppercase tracking-[0.25em] text-cover-cream/90">
      {t(locale, 'site.tagline')}
    </p>
    <h1
      class="ht-title break-words font-display text-3xl font-bold leading-[1.05] sm:text-5xl"
      style="font-variant-caps: small-caps; letter-spacing: 0.04em;"
    >
      SchaakStudieSpinselS
      <span class="block text-5xl sm:text-7xl">2</span>
    </h1>
    <div class="ht-logo">
      <CoverMark class="h-48 w-48 sm:h-60 sm:w-60" />
    </div>
    <p class="ht-subtitle text-cover-cream/90 sm:max-w-md">
      {t(locale, 'site.subtitle')}
    </p>
  </div>
</section>

<style>
  /* Mobile portrait: one centred column — tagline, title, 2, logo, then the
     subtitle directly under the logo. */
  .hero-grid {
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
    grid-template-columns: 1fr;
    grid-template-areas:
      'tagline'
      'title'
      'logo'
      'subtitle';
  }
  .ht-tagline { grid-area: tagline; }
  .ht-title { grid-area: title; }
  .ht-logo { grid-area: logo; }
  .ht-subtitle { grid-area: subtitle; }

  /* From sm up: text column on the left, logo on the right (book-cover feel). */
  @media (min-width: 640px) {
    .hero-grid {
      grid-template-columns: 1fr auto;
      column-gap: 1.5rem;
      row-gap: 0.75rem;
      justify-items: start;
      align-items: center;
      text-align: left;
      grid-template-areas:
        'tagline  logo'
        'title    logo'
        'subtitle logo';
    }
    .ht-logo {
      justify-self: center;
      align-self: center;
    }
  }
</style>
