  "prose": {
    "nl": {
      "before": "Beide tegenstanders hebben het-\nzelfde  materiaal. Maar  het  wit\npaard en de  pion  staan  beide\naangevallen, zodat 1.Kf3?, om de\nvlucht van het paard te beletten,\nzinloos is.",
      "after": "",
      "beforeVariant": {
        "A": "Wit heeft de pion geofferd voor de\nloper. Nu nog het paard vangen.",
        "B": "Er  dreigt nu  reeds  4.Kf3 met\nverovering van het zwarte paard.\nDaarom:\n\n8.Kg5? f4 9.Kxf4 Kh8 10.Pf6 Pe6\n11.Lxe6 is een onnodige omweg.\n\nEn wit wint. Ook na:"
      }
    }
