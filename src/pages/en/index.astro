---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverMark from '../../components/CoverMark.astro';
import { getCollection } from 'astro:content';
import { t } from '../../i18n/ui';
import { chapterAnchor } from '../../lib/chapters';

const locale = 'en';

const studies = await getCollection('studies');
const byChapter = new Map<number, { name: string; count: number }>();
for (const s of studies) {
  const e = byChapter.get(s.data.chapterNumber) ?? { name: s.data.chapter, count: 0 };
  e.count++;
  byChapter.set(s.data.chapterNumber, e);
}
const groups = [...byChapter.entries()]
  .map(([number, { name, count }]) => ({ number, name, count }))
  .sort((a, b) => a.number - b.number);
const total = studies.length;
---

<BaseLayout title={t(locale, 'site.title')} locale={locale} pathSansLocale="/">
  <section class="overflow-hidden rounded-2xl bg-gold text-paper-light shadow-md">
    <div class="grid items-center gap-6 p-8 sm:grid-cols-[1fr_auto] sm:p-12">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-cover-cream/90">
          {t(locale, 'site.tagline')}
        </p>
        <h1 class="mt-3 break-words font-display text-3xl font-bold leading-[1.05] sm:text-5xl" style="font-variant-caps: small-caps; letter-spacing: 0.04em;">
          Schaakstudiespinsels
          <span class="block text-5xl sm:text-7xl">2</span>
        </h1>
        <p class="mt-4 max-w-md text-cover-cream/90">
          {t(locale, 'site.subtitle')}
        </p>
      </div>
      <CoverMark class="mx-auto h-48 w-48 sm:h-60 sm:w-60" />
    </div>
  </section>

  <section class="mx-auto mt-10 max-w-2xl text-center">
    <p class="text-lg text-ink-soft">{t(locale, 'home.intro')}</p>
    <a
      href={`/${locale}/studies/`}
      class="mt-6 inline-block rounded-full bg-accent px-6 py-3 font-medium text-paper-light no-underline shadow-sm transition hover:bg-accent/90"
    >
      {t(locale, 'home.cta')} &rarr;
    </a>
  </section>

  <section class="mt-14">
    <div class="flex items-baseline justify-between">
      <h2 class="font-display text-2xl" style="font-variant-caps: small-caps; letter-spacing: 0.05em;">
        {t(locale, 'home.groups')}
      </h2>
      <span class="text-sm text-ink-muted">{total} {t(locale, 'study.count')}</span>
    </div>

    <ul class="mt-5 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {groups.map((g) => (
        <li>
          <a
            href={`/${locale}/studies/#${chapterAnchor(g.number)}`}
            class="group flex h-full items-center gap-4 rounded-xl border border-ink-muted/20 bg-paper px-5 py-4 no-underline transition hover:-translate-y-0.5 hover:border-gold hover:shadow-md"
          >
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gold/15 font-display text-lg font-semibold text-gold-dark">
              {g.number}
            </span>
            <span class="min-w-0">
              <span class="block font-display text-lg leading-tight text-ink group-hover:text-accent">{g.name}</span>
              <span class="text-sm text-ink-muted">{g.count} {t(locale, 'study.count')}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
