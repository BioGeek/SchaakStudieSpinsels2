---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { t, type Locale } from '../../../i18n/ui';

export function getStaticPaths() {
  return [{ params: { locale: 'nl' } }, { params: { locale: 'en' } }];
}

const locale = Astro.params.locale as Locale;
const studies = (await getCollection('studies')).sort((a, b) => a.data.number - b.data.number);

// Group by chapter so the list reads like the book's TOC.
const byChapter = new Map<number, { name: string; studies: typeof studies }>();
for (const s of studies) {
  const entry = byChapter.get(s.data.chapterNumber) ?? { name: s.data.chapter, studies: [] };
  entry.studies.push(s);
  byChapter.set(s.data.chapterNumber, entry);
}
---

<BaseLayout title={t(locale, 'nav.studies')} locale={locale} pathSansLocale="/studies/">
  <section class="prose prose-lg mx-auto">
    <h1 class="title text-center text-4xl">{t(locale, 'nav.studies')}</h1>

    {[...byChapter.entries()].sort((a, b) => a[0] - b[0]).map(([num, { name, studies }]) => (
      <section class="mt-8">
        <h2>{num}. {name}</h2>
        <ul class="list-none p-0 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {studies.map((s) => (
            <li>
              <a
                href={`/${locale}/studies/${String(s.data.number).padStart(3, '0')}/`}
                class="block rounded border border-ink-muted/30 bg-paper px-3 py-2 no-underline hover:border-accent hover:text-accent"
              >
                <div class="flex items-baseline justify-between gap-2">
                  <span class="font-mono font-semibold">{s.data.number}</span>
                  <span class="font-mono text-xs text-ink-muted">
                    {s.data.stipulation} {s.data.gbr}
                  </span>
                </div>
                {s.data.source && (
                  <p class="mt-1 text-xs italic text-ink-muted line-clamp-1">
                    {s.data.source}
                  </p>
                )}
                <p class="mt-1 text-xs text-ink-muted">
                  {s.data.moves.length} {t(locale, 'study.moves').toLowerCase()}
                </p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </section>
</BaseLayout>
