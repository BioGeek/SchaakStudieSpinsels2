---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StudyBoard from '../../../components/StudyBoard.astro';
import StudyNav from '../../../components/StudyNav.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { t, type Locale } from '../../../i18n/ui';

export async function getStaticPaths() {
  // Sort so prev/next hop to the adjacent *shipped* study (numbering has gaps).
  const studies = (await getCollection('studies')).sort(
    (a, b) => a.data.number - b.data.number
  );
  const paths = [];
  studies.forEach((s, i) => {
    const prevNum = studies[i - 1]?.data.number ?? null;
    const nextNum = studies[i + 1]?.data.number ?? null;
    for (const locale of ['nl', 'en'] as const) {
      paths.push({
        params: { locale, num: String(s.data.number).padStart(3, '0') },
        props: { study: s, locale, prevNum, nextNum },
      });
    }
  });
  return paths;
}

interface Props {
  study: CollectionEntry<'studies'>;
  locale: Locale;
  prevNum: number | null;
  nextNum: number | null;
}

const { study, locale, prevNum, nextNum } = Astro.props;
const data = study.data;
const title = `${data.chapter} — ${data.stipulation} ${data.gbr}`;
const num = String(data.number).padStart(3, '0');

// Optional bird's-eye variant tree (generated by scripts/variant_tree_svg.py),
// shown only for studies that have one.
const trees = import.meta.glob('../../../variant-trees/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const treeSvg = trees[`../../../variant-trees/${num}.svg`];
---

<BaseLayout title={title} locale={locale} pathSansLocale={`/studies/${num}`}>
  <article class="study">
    <header class="mb-6 text-center">
      <p class="text-sm uppercase tracking-widest text-ink-muted">
        {data.chapter}
      </p>
      <h1 class="title text-4xl my-2">— {data.number} —</h1>
    </header>

    <div class="mb-8 mt-6">
      <StudyNav
        locale={locale}
        prevNum={prevNum}
        nextNum={nextNum}
        chapterNumber={data.chapterNumber}
      />
    </div>

    <StudyBoard study={data} locale={locale} />

    {treeSvg && (
      <details class="variant-tree">
        <summary>{locale === 'en' ? 'Variant tree' : 'Variantenboom'}</summary>
        <div class="variant-tree-svg" set:html={treeSvg} />
      </details>
    )}

    <div class="mt-12 border-t border-ink-muted/20 pt-6">
      <StudyNav
        locale={locale}
        prevNum={prevNum}
        nextNum={nextNum}
        chapterNumber={data.chapterNumber}
      />
    </div>
  </article>
</BaseLayout>

<style>
  .variant-tree {
    margin-top: 2.5rem;
    border-top: 1px solid rgb(107 95 75 / 0.2);
    padding-top: 1.25rem;
  }
  .variant-tree > summary {
    cursor: pointer;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #7a1f0e;
    list-style: none;
  }
  .variant-tree > summary::before {
    content: '▸';
    display: inline-block;
    margin-right: 0.4rem;
    transition: transform 0.15s;
  }
  .variant-tree[open] > summary::before {
    transform: rotate(90deg);
  }
  .variant-tree-svg {
    margin-top: 0.85rem;
    overflow-x: auto;
  }
  .variant-tree-svg :global(svg) {
    width: 100%;
    height: auto;
    min-width: 560px;
  }
</style>
